{
  "id": "tile-companions",
  "type": "module",
  "title": "Tile Companions",
  "description": "Bind a Region, an Ambient Sound and/or an Ambient Light to a Tile: the region takes the visible (alpha) outline of the tile image, and all companions follow the tile when it is moved, resized, rotated, flipped, hidden or deleted. Also adds tokenless click behaviors for regions (run a macro, go to a scene, open a journal, local jukebox) usable by players. System-agnostic.",
  "version": "0.2.0",
  "url": "https://github.com/Darshyne/tile-companions",
  "license": "MIT",
  "manifest": "https://github.com/Darshyne/tile-companions/releases/latest/download/module.json",
  "download": "https://github.com/Darshyne/tile-companions/releases/latest/download/module.zip",
  "authors": [
    {
      "name": "Darsh MJ"
    }
  ],
  "compatibility": {
    "minimum": "13",
    "verified": "14"
  },
  "esmodules": [
    "scripts/main.js"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "fr",
      "name": "Français",
      "path": "lang/fr.json"
    }
  ],
  "readme": "https://github.com/Darshyne/tile-companions/blob/main/README.md",
  "documentTypes": {
    "RegionBehavior": {
      "clickMacro": {},
      "toScene": {},
      "openDocument": {},
      "jukebox": {}
    }
  },
  "socket": true
}
